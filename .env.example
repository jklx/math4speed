# LTI 1.3 registration for one Moodle platform. Keep actual values in .env.
LTI_TOOL_ORIGIN=https://math4speed.example.edu
LTI_PLATFORM_ISSUER=https://moodle.example.edu
LTI_PLATFORM_CLIENT_ID=replace-with-moodle-client-id
LTI_PLATFORM_AUTHORIZATION_ENDPOINT=https://moodle.example.edu/mod/lti/auth.php
LTI_PLATFORM_JWKS_URL=https://moodle.example.edu/mod/lti/certs.php
LTI_PLATFORM_DEPLOYMENT_ID=replace-with-moodle-deployment-id
# Optional, test-only onboarding mode for one trusted Moodle issuer. Client and
# deployment IDs are then read from the signed LTI start flow.
# LTI_AUTO_PLATFORM_ISSUER=https://lernplattform.bycs.de
# Either an inline PEM value (with \\n) or a path to a PEM file.
LTI_PRIVATE_KEY=path-to-private-key.pem
LTI_KEY_ID=math4speed-key-1
