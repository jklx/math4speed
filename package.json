    "pdf:sample": "node server/generateSampleReport.js",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pdfkit": "^0.15.2",
    "pg": "8.13.1",
